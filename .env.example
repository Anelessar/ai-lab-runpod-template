AI_LAB_ROOT=/workspace/ai-lab
AI_LAB_TEMPLATE_ROOT=/opt/ai-lab-template
AI_LAB_CONTAINER_GB=500
AI_LAB_GPU_ID=NVIDIA B200
AI_LAB_STOP_AFTER=12h
# Шаблон автоматически подключает RunPod Secret с именем huggingface_token.
# Если Secret назван иначе: AI_LAB_HF_SECRET_NAME=имя_секрета
# JUPYTER_TOKEN задайте секретом, если Jupyter должен быть защищён паролем.
